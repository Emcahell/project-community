# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxx

# URL pública del sitio (enlaces de recuperación de contraseña)
SITE_URL=http://localhost:3000

# Solo para el servidor MCP de Supabase usado por Claude Code (.mcp.json).
# Token personal: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
